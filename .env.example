# === Binflow — Plantilla de variables de entorno ===
# Copia este archivo a .env y rellena los valores reales.
# El .env real está ignorado por git y nunca se sube al repo.

# Personal Access Token de Figma (Settings > Account > Personal access tokens)
FIGMA_TOKEN=

# ID del archivo de Figma de la landing.
# Se saca de la URL: https://www.figma.com/design/<FIGMA_FILE_KEY>/nombre-del-archivo
FIGMA_FILE=
