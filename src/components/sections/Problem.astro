---
import { Mail, Eye, Bot, Coins, Shield } from '@lucide/astro';
import SectionHeader from '../ui/SectionHeader.astro';

const painPoints = [
  {
    icon: Mail,
    title: '¿Cuántas veces has esperado días por un simple cambio de texto?',
    body: 'Un cambio que toma 2 minutos se convierte en correos, reuniones y días de espera. Tu web no puede depender de la agenda de otros.'
  },
  {
    icon: Eye,
    title: '¿Cuánto tardan en actualizar una imagen en tu página?',
    body: 'Cambiar una foto, un banner o un menú no debería tomar una semana. Pero sin las herramientas correctas, cada cambio visual es un proyecto.'
  },
  {
    icon: Bot,
    title: '¿Qué haces si tu agencia o desarrollador desaparece?',
    body: 'Tu negocio no puede parar porque alguien no contesta. Necesitas una forma de hacer cambios sin depender de terceros ni de su disponibilidad.'
  },
  {
    icon: Coins,
    title: '¿Sabes realmente cuánto te cuesta cada cambio en tu web?',
    body: 'Entre horas de diseñador, desarrollador y coordinación, un cambio "pequeño" puede costarte más de lo que imaginas. Y ni lo ves venir.'
  },
  {
    icon: Shield,
    title: '¿Has publicado algo y tu web se rompió?',
    body: 'Sin preview ni validación, cada publicación es un riesgo. Un error en producción puede costarte clientes, ventas y credibilidad.'
  }
];
---

<section class="bg-surface-alt py-16 lg:py-24">
  <div class="container-page flex flex-col items-center gap-12">
    <SectionHeader
      eyebrow="EL PROBLEMA DE SIEMPRE"
      title={`Actualizar la web de tu negocio\nno debería costar una semana,\nni tres personas`}
      preserveLineBreaks
    />

    <!-- Timeline en zigzag: columnas de 360px con una vía central de 72px -->
    <ol class="relative w-full max-w-[792px]">
      <!-- Vía vertical continua -->
      <span
        class="absolute inset-y-0 left-[15px] w-0.5 bg-line-strong lg:left-1/2 lg:-translate-x-1/2"
        aria-hidden="true"></span>

      {
        painPoints.map((point, index) => {
          const Icon = point.icon;
          const isLeft = index % 2 === 0;

          return (
            <li
              class="relative flex gap-6 pb-8 last:pb-0 lg:grid lg:grid-cols-[360px_72px_360px] lg:gap-0 lg:pb-2"
              data-reveal
            >
              {/* Nodo con icono — en móvil va a la izquierda, en desktop en la vía central */}
              <div class="relative z-10 shrink-0 lg:order-2 lg:flex lg:justify-center">
                <span class="flex size-8 items-center justify-center rounded-full bg-brand ring-4 ring-surface-alt">
                  <Icon class="size-4 text-white" stroke-width={2} aria-hidden="true" />
                </span>
              </div>

              {/* Contenido */}
              <div
                class:list={[
                  'pt-1 lg:pt-0',
                  isLeft ? 'lg:order-1 lg:pr-6' : 'lg:order-3 lg:pl-6'
                ]}
              >
                <h3 class="text-[18px] leading-[1.35] font-bold text-ink lg:text-[20px]">
                  {point.title}
                </h3>
                <p class="mt-3 text-[15px] leading-[1.6] text-body">{point.body}</p>
              </div>

              {/* Columna vacía del lado opuesto */}
              <div
                class:list={['hidden lg:block', isLeft ? 'lg:order-3' : 'lg:order-1']}
                aria-hidden="true"
              />
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
